    "# functions\n",
    "def count_5(st,x,delimiter):\n",
    "    st = st.replace(delimiter,\"\")\n",
    "    st_list = st.split()\n",
    "    L = []\n",
    "    for i in st_list:\n",
    "        if len(i) == x:\n",
    "          L.append(i)\n",
    "\n",
    "    print(len(L))\n"
