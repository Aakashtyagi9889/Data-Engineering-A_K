   "source": [
    "#Data Types in python -->String , list , tuples , set , dict \n",
    "# string =  It store alphanumeric text\n",
    "# Features - Mutability -------->Immutable\n",
    "a = \"I Love DE 101\"\n",
    "type(a)\n",
    "\n",
    "print(a[3]) #INDEXING\n",
    "print(a[-6]) # REVERSE INDEXING\n",
    "print(a[7:9]) # Slicing \n",
    "print(a[0:13:2]) \n",
    "print(a[-3:]) # Reverse Slicing \n",
    "print(a[-6:-4])\n",
    "\n",
    "# Reverse the string  (Interview Question)\n",
    "print(a[::-1])\n",
    "\n",
    "# Love ==> evoL\n",
    "print(a[-8:-12  :-1])\n",
    "# without using negative slicing\n",
    "print(a[2:6][::-1])\n"
   ]
